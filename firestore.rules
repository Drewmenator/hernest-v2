rules_version = '2';

// ─── HerNest Firestore Security Rules ────────────────────────────
// Source of truth for access control. Created for migration Steps 1–2.
//
// Model: a household's id IS the owner's uid. Every user has full access to
// their OWN namespace (unchanged from before). Household MEMBERS additionally
// get access to a fixed set of SHARED collections under the owner's namespace,
// plus the household doc, member roster, and append-only event log.
//
// Membership is anchored to users/{uid}/data/household_link, which is written
// ONLY by the trusted /api/invite/accept admin endpoint — so a client cannot
// grant itself membership in someone else's household.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Collections under users/{ownerUid}/data that are shared with the whole
    // household. KEEP IN SYNC with HOUSEHOLD_COLLECTIONS in src/core/identity.ts.
    // (thrive + cleo_memory* are intentionally NOT here — they stay personal
    // until per-member consent lands in migration Step 5.)
    function householdShared() {
      return [
        'budget', 'budget_v2', 'bills', 'tasks', 'calendar', 'calendar_synced',
        'trips', 'school', 'circle', 'family', 'items_migration'
      ];
    }

    // Shared lists stored as one doc per item: users/{ownerUid}/{col}/{id}.
    // KEEP IN SYNC with ITEM_KINDS in src/core/householdItemsCore.ts.
    // (data/tasks and data/bills above are the old whole-list docs, kept as
    // a backup after the one-time copy.)
    function householdItemCollections() {
      return ['tasks', 'chores', 'bills'];
    }

    // True if the signed-in user belongs to household {ownerUid}: either they
    // ARE the owner, or the trusted invite flow wrote them a household_link
    // pointing at it. (get/exists in rules are privileged — they bypass rules.)
    // Event types about shared household things. KEEP IN SYNC with
    // isSharedEventType() in src/core/events/index.ts.
    function sharedEventType(t) {
      return t is string
        && (t.matches('^(plan|trips|family|calendar|circle)[.].*') || t == 'partner.invite.accepted');
    }

    function isMember(ownerUid) {
      return isSignedIn() && (
        request.auth.uid == ownerUid ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/data/household_link) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)/data/household_link).data.primaryUid == ownerUid
        )
      );
    }

    // Server-written records the client may read but never write. usage holds
    // the daily AI counter (a client reset would bypass the quota) and
    // integrations holds OAuth tokens + sync metadata (admin SDK only).
    function serverOnlyCollections() {
      return ['usage', 'integrations'];
    }

    // Docs under data/ only the admin SDK may write. subscription is set by
    // the Stripe webhook; a client write would self-grant Pro.
    function serverOnlyDataDocs() {
      return ['household_link', 'subscription'];
    }

    // ── User namespace ───────────────────────────────────────────
    // Full access to your OWN namespace EXCEPT data/ (handled explicitly
    // below so household_link can be locked down — see security note) and
    // the server-only collections (read-only for the owner).
    match /users/{ownerUid}/{col}/{document=**} {
      allow read: if isSignedIn() && request.auth.uid == ownerUid && col != 'data';
      allow write: if isSignedIn() && request.auth.uid == ownerUid && col != 'data'
                   && !serverOnlyCollections().hasAny([col])
                   && !householdItemCollections().hasAny([col]); // per-item rules below
    }

    // data/: owner reads everything; owner writes everything EXCEPT
    // household_link and subscription. SECURITY: household_link is what isMember() trusts —
    // if clients could write their own, anyone could forge a link pointing
    // at any household and read its shared data (found by the rules test
    // suite, 2026-07-10). Only the admin SDK (/api/invite/accept and
    // /api/household) may write it — admin bypasses rules.
    // Household members additionally read/write the shared subset.
    match /users/{ownerUid}/data/{col} {
      allow read: if (isSignedIn() && request.auth.uid == ownerUid)
                  || (householdShared().hasAny([col]) && isMember(ownerUid));
      allow write: if (isSignedIn() && request.auth.uid == ownerUid && !serverOnlyDataDocs().hasAny([col]))
                   || (householdShared().hasAny([col]) && isMember(ownerUid));
    }

    // Per-item household records (tasks, chores, bills): the owner and
    // household members read and write them; nobody else can. Each item is
    // its own doc so two people's edits can't overwrite each other.
    match /users/{ownerUid}/{col}/{itemId} {
      allow read, delete: if householdItemCollections().hasAny([col]) && isMember(ownerUid);
      allow create, update: if householdItemCollections().hasAny([col]) && isMember(ownerUid)
                            && onlyAssigneeAnswers(col);
    }

    // Task ownership: a task given to another adult can only be marked
    // accepted or declined by that person, so nobody else (and no assistant
    // acting for the asker) can make it look handled.
    function onlyAssigneeAnswers(col) {
      let newState = request.resource.data.get('state', null);
      let oldState = resource == null ? null : resource.data.get('state', null);
      return col != 'tasks'
        || !(newState in ['accepted', 'declined'])
        || newState == oldState
        || request.auth.uid == request.resource.data.get('assigneeUid', null);
    }

    // ── Households ───────────────────────────────────────────────
    match /households/{hid} {
      allow read: if isMember(hid);
      // You can only create/update YOUR OWN household doc (hid == your uid).
      allow create, update: if isSignedIn() && request.auth.uid == hid;
      allow delete: if false;

      // Member roster — each user writes only their OWN membership, and only
      // into a household they legitimately belong to (owner, or invited).
      match /members/{memberUid} {
        allow read: if isMember(hid);
        allow create, update: if request.auth.uid == memberUid && isMember(hid);
        allow delete: if request.auth.uid == memberUid || request.auth.uid == hid;
      }

      // Shared, append-only household event log (migration Step 2).
      // PRIVACY: only shared-household event types, marked household/partners,
      // may be written. Older private events written before this rule (chats,
      // crisis alerts, mood) stay readable only by the person who wrote them.
      match /events/{eventId} {
        // `shared == true` (rather than checking the type) so the app's
        // whole-log query can be allowed; create guarantees shared events have
        // a shared type, and older docs without the flag stay hidden.
        allow read: if isMember(hid)
                    && (resource.data.get('shared', false) == true || resource.data.actorUserId == request.auth.uid);
        allow create: if isMember(hid)
                      && request.resource.data.actorUserId == request.auth.uid
                      && request.resource.data.get('shared', false) == true
                      && sharedEventType(request.resource.data.type)
                      && request.resource.data.visibility in ['household', 'partners'];
        allow update, delete: if false; // append-only
      }
    }

    // ── Invites ──────────────────────────────────────────────────
    // Read/written only by the admin SDK in /api/invite/*. No client access.
    match /invites/{token} {
      allow read, write: if false;
    }

    // ── AI usage + cost records ─────────────────────────────────
    // Per-household daily AI call counts, tokens and cost (ai_usage) and the
    // per-user per-minute counter (ai_burst). Written only by /api/claude via
    // the admin SDK; a client write could reset its own limits.
    match /ai_usage/{document=**} {
      allow read, write: if false;
    }
    match /ai_burst/{uid} {
      allow read, write: if false;
    }

    // Everything else is denied by Firestore's default (no matching allow).
  }
}
